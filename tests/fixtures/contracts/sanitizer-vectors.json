{
 "description": "契约 v1.2 §5.4 sanitizer 人工 golden 向量（期望值手写；测试=真实现对拍人工期望，非自证；c4 送审逐条审定）",
 "vectors": [
  {
   "name": "多段 POSIX 绝对路径遮蔽",
   "kind": "text",
   "limit": 200,
   "input": "看 /home/user/.ssh/id_rsa 文件",
   "expect": {
    "text": "看 [path] 文件",
    "truncated": false
   }
  },
  {
   "name": "单段路径允许透出（命名性内容，声明）",
   "kind": "text",
   "limit": 200,
   "input": "/secret 是单段",
   "expect": {
    "text": "/secret 是单段",
    "truncated": false
   },
   "note": "允许透出——契约声明单段路径为命名性内容"
  },
  {
   "name": "中文多段路径遮蔽",
   "kind": "text",
   "limit": 200,
   "input": "在 /资料/密码 目录",
   "expect": {
    "text": "在 [path] 目录",
    "truncated": false
   }
  },
  {
   "name": "相对路径多段同遮（保守）",
   "kind": "text",
   "limit": 200,
   "input": "a/b/c 是相对路径",
   "expect": {
    "text": "a[path] 是相对路径",
    "truncated": false
   }
  },
  {
   "name": "file:// URL 路径连带遮蔽（保守）",
   "kind": "text",
   "limit": 200,
   "input": "file:///home/user/doc.txt",
   "expect": {
    "text": "file:[url]",
    "truncated": false
   },
   "note": "URL host+path 被保守连带遮蔽"
  },
  {
   "name": "https URL 无 userinfo",
   "kind": "text",
   "limit": 200,
   "input": "访问 https://example.com/docs/a/b",
   "expect": {
    "text": "访问 https:[url]",
    "truncated": false
   },
   "note": "//example.com 起被路径形态吞并（lookbehind 只排除冒号紧邻首斜杠）"
  },
  {
   "name": "URL userinfo 整体遮蔽（B05）",
   "kind": "text",
   "limit": 200,
   "input": "https://user:pass@example.com/x",
   "expect": {
    "text": "[url]",
    "truncated": false
   },
   "note": "带凭据 URL 比裸 URL 更敏感：整条遮蔽，不保留 scheme（c4-B05）"
  },
  {
   "name": "Windows 盘符路径",
   "kind": "text",
   "limit": 200,
   "input": "C:\\Users\\admin\\secrets.txt",
   "expect": {
    "text": "[path]",
    "truncated": false
   }
  },
  {
   "name": "UNC 路径",
   "kind": "text",
   "limit": 200,
   "input": "\\\\server\\share\\conf",
   "expect": {
    "text": "[path]",
    "truncated": false
   }
  },
  {
   "name": "env 赋值遮蔽",
   "kind": "text",
   "limit": 200,
