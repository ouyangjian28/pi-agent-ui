   "kind": "id",
   "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
   "expect": {
    "idPattern": "^~id-[0-9a-f]{16}$"
   }
  },
  {
   "name": "机器 ID：映射稳定（同输入同输出）",
   "kind": "id",
