  },
  {
   "name": "机器 ID：合法 entryId 原样",
   "kind": "id",
   "input": "m-000123.045",
   "expect": {
    "id": "m-000123.045"
   }
  },
  {
   "name": "机器 ID：凭据形态不外发（先凭据后白名单）",
